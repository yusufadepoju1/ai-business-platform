# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# PostgreSQL (recommended). Without it the app falls back to a local SQLite file (dev only).
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_business
PUBLIC_BASE_URL=http://localhost:8000

# AI (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: auto | sentence-transformers | hashing
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIR=./data/vectors

# Server-wide SMTP (optional; each business can also set its own in the UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Security / behaviour
CORS_ORIGINS=
ALLOW_PRIVATE_WEBHOOK_TARGETS=true
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
